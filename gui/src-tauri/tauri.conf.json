{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ombro",
  "version": "0.1.0",
  "identifier": "app.ombro.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ombro",
        "width": 1100,
        "height": 820,
        "minWidth": 900,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ombro-serve"
    ],
    "resources": {
      "python/": "python/"
    },
    "category": "Productivity",
    "shortDescription": "Brief a crew of AI roles and get bounded, reported work back.",
    "publisher": "Heliotrope Atelier Ltd",
    "copyright": "Copyright © 2026 Heliotrope Atelier Ltd",
    "license": "AGPL-3.0-only",
    "licenseFile": "../../LICENSE",
    "macOS": {
      "files": {
        "Resources/Assets.car": "icons/macos/Assets.car"
      },
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBQTVGQzk1QzFGOUE5OTEKUldTUnFmbkJsZnlsS2x0VFpmemYveXFEZlMxWlRFdFFCMzlidUpOeVBNRmU3OXdwU3B0VFQ5L1kK",
      "endpoints": [
        "https://github.com/mrkrsl/ombro/releases/latest/download/latest.json"
      ]
    }
  }
}
