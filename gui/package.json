{
  "name": "ombro-gui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "sidecar": "uv run --group build python scripts/build_sidecar.py",
    "tauri": "tauri",
    "types": "json2ts -i src/api/schema.json -o src/api/types.ts --unreachableDefinitions --additionalProperties false --bannerComment \"// Generated from src/api/schema.json by npm run types. Do not edit.\"",
    "schema": "cd .. && uv run python gui/scripts/schema.py"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
