{
  "name": "ombro-gui",
  "private": true,
  "version": "0.4.0",
  "license": "AGPL-3.0-only",
  "author": "Heliotrope Atelier Ltd",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "sidecar": "uv run --group build python scripts/build_sidecar.py",
    "tauri": "tauri",
    "types": "json2ts -i src/api/schema.json -o src/api/types.ts --unreachableDefinitions --additionalProperties false --bannerComment \"// Generated from src/api/schema.json by npm run types. Do not edit.\"",
    "schema": "cd .. && uv run python gui/scripts/schema.py",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-notification": "2.8.1",
    "@tauri-apps/plugin-opener": "2.7.3",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "31.0.1",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
